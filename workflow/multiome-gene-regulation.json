{
  "name": "Multiome Gene Regulation",
  "summary": "10x Multiome: RNA cell types, ATAC QC, peaks and motifs per cell type, peak-to-gene links.",
  "description": "Links gene regulation to cell types in single-nucleus multiome (RNA + ATAC) data such as 10x Cell Ranger ARC outputs. The RNA side runs as in the single-nucleus workflow (sc-prep, sc-qc, sc-integrate, sc-annotate) and gives every nucleus a cell type; atac-prep imports the ATAC fragments of the nuclei that passed RNA QC and filters them on fragment counts and TSS enrichment (SnapATAC2); atac-regulome calls peaks per cell type (MACS3, ENCODE blacklist for GRCh38), finds marker peaks, tests JASPAR 2026 motifs against a GC-matched background, and links peaks to genes from the RNA; sc-report writes the HTML report with citations. If you used Pennsieve to store, analyse, share or publish data reported in a publication, please cite Goldblum Z, et al. Scientific Data 2025;12:1834 (doi:10.1038/s41597-025-06075-5), the datasets you used and the methods listed in the report.",
  "inputs": [
    {
      "id": "multiome",
      "name": "Multiome data",
      "description": "Cell Ranger ARC outputs per sample (filtered_feature_bc_matrix.h5, atac_fragments.tsv.gz and .tbi), with optional samples.csv or SPARC samples.xlsx / subjects.xlsx.",
      "position": {
        "x": 40,
        "y": 300
      }
    }
  ],
  "outputs": [
    {
      "id": "report_out",
      "name": "Report",
      "from": {
        "step": "report",
        "output": "report"
      },
      "position": {
        "x": 1860,
        "y": 170
      },
      "default": {
        "targetType": "Pennsieve Dataset",
        "params": {
          "TARGET_FOLDER": "derivatives/multiome/report"
        }
      }
    },
    {
      "id": "tables_out",
      "name": "Tables",
      "from": {
        "step": "report",
        "output": "tables"
      },
      "position": {
        "x": 1860,
        "y": 300
      },
      "default": {
        "targetType": "Pennsieve Dataset",
        "params": {
          "TARGET_FOLDER": "derivatives/multiome/tables"
        }
      }
    },
    {
      "id": "regulome_out",
      "name": "Peaks, motifs and links",
      "from": {
        "step": "regulome",
        "output": "regulome"
      },
      "position": {
        "x": 1860,
        "y": 430
      },
      "default": {
        "targetType": "Pennsieve Dataset",
        "params": {
          "TARGET_FOLDER": "derivatives/multiome/regulome"
        }
      }
    }
  ],
